{
  "name": "evadiff",
  "version": "1.0.0",
  "description": "Highly configurable subtitle comparison tool, works offline with optional online sharing.",
  "scripts": {
    "test": "tsc -p . && eslint src --ext .ts,.js",
    "dev": "parcel src/index.html",
    "build": "parcel build src/index.html --public-url ./"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Irrational-Sneed-Wizardry/evadiff.git"
  },
  "keywords": [
    "subtitles",
    "comparison",
    "anime"
  ],
  "author": "eva",
  "license": "GPLv3",
  "bugs": {
    "url": "https://github.com/Irrational-Sneed-Wizardry/evadiff/issues"
  },
  "homepage": "https://github.com/Irrational-Sneed-Wizardry/evadiff",
  "private": true,
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "eslintConfig": {
    "root": true,
    "extends": "standard",
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "env": {
      "browser": true
    },
    "rules": {
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": "error"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "parcel": "^2.12.0",
    "process": "^0.11.10",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "diff2html": "^3.4.48",
    "html-to-image": "^1.11.11",
    "subsrt": "github:po5/subsrt"
  }
}
